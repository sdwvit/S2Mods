{
  "name": "@sdwvit/s2mods",
  "version": "1.0.0",
  "description": "Get Stalker 2 game data from ObjPrototypes",
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "prepare-configs": "node ./src/run-ts.mjs ./src/prepare-configs.mts",
    "prepare-configs:mods": "pnpm -r --parallel --if-present run prepare-configs",
    "pack-inject": "node ./src/run-ts.mjs ./src/pack-inject.mts",
    "cook-inject": "node ./src/run-ts.mjs ./src/cook-inject.mts",
    "publish-steam": "node ./src/run-ts.mjs ./src/publish/publish-steam.mts",
    "publish-modio": "node ./src/run-ts.mjs ./src/publish/publish-modio.mts",
    "zip-for-xbox": "node ./src/run-ts.mjs ./src/publish/zip-for-xbox.mts",
    "publish-platforms": "node ./src/run-ts.mjs ./src/publish/publish-platforms.mts",
    "check-unpublished": "node ./src/run-ts.mjs ./src/publish/check-unpublished-mods.mts",
    "update-readme": "node ./src/run-ts.mjs ./src/update-readme.mts",
    "update-readme:mods": "pnpm -r --parallel --if-present run update-readme",
    "prepare-all": "node ./src/run-ts.mjs ./src/prepare-all.ts",
    "push-to-sdk": "node ./src/run-ts.mjs ./src/push-to-sdk.mts",
    "pull-staged": "node ./src/run-ts.mjs ./src/pull-staged.mts",
    "pull-assets": "node ./src/run-ts.mjs ./src/pull-assets.mts",
    "purge-caches": "find . -path '*/node_modules' -prune -o -type f -name '.*.cache.zlib' -exec rm -f {} +",
    "create-git-branches": "node ./src/run-ts.mjs ./src/gitbranches/create-git-branches.mts"
  },
  "devDependencies": {
    "@node-steam/vdf": "^2.2.0",
    "@types/archiver": "^7.0.0",
    "@types/node": "^20.11.17",
    "archiver": "^7.0.1",
    "dotenv": "^17.2.0",
    "prettier": "^3.6.2",
    "s2cfgtojson": "7.0.20",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
