import { describe, expect, it } from "vitest";
import { copyFileSync, existsSync, mkdirSync, mkdtempSync, readdirSync, readFileSync } from "node:fs";
import { tmpdir } from "node:os";
import path from "node:path";

import { parseUasset, writeWorldSubsystemData } from "./localization/uasset.mts";
import { findWorldSubsystemClasses, writeModWorldSubsystemData } from "./world-subsystem-data.mts";

const FIXTURES = path.join(import.meta.dirname, "localization/fixtures");

/** HeadlessArmors' `Autogenerated_1791837141_WorldSubsystemData`, as the Mod Editor packaged it. */
const AUTHORED = path.join(FIXTURES, "authored-world-subsystem-data.uasset");
/** HeadlessArmors' `announce_mod_is_active`: a blueprint whose parent is `ModWorldSubsystem`. */
const BLUEPRINT = path.join(FIXTURES, "world-subsystem-blueprint.uasset");

const CLASS = "/HeadlessArmors/announce_mod_is_active.announce_mod_is_active_C";

const listOf = (file: string) =>
  parseUasset(file).exports.find((e) => e.className === "ModWorldSubsystemDataAsset")?.properties
    ?.ModWorldSubsystems;

/** A mod's raw/ and SDK `Content` folders, both holding `files` (name -> source). */
function modDirs(files: Record<string, string>) {
  const root = mkdtempSync(path.join(tmpdir(), "world-subsystem-data-test-"));
  const dirs = [path.join(root, "raw"), path.join(root, "sdk")];
  for (const dir of dirs) {
    mkdirSync(dir);
    for (const [name, source] of Object.entries(files)) copyFileSync(source, path.join(dir, name));
  }
  return dirs as [string, string];
}

describe("writeWorldSubsystemData", () => {
  it("reproduces the editor's asset byte for byte", () => {
    const dest = path.join(mkdtempSync(path.join(tmpdir(), "wsd-")), "out.uasset");
    writeWorldSubsystemData(AUTHORED, [CLASS], dest);
    expect(readFileSync(dest).equals(readFileSync(AUTHORED))).toBe(true);
  });

  it("writes any number of class paths", () => {
    const dest = path.join(mkdtempSync(path.join(tmpdir(), "wsd-")), "out.uasset");
    writeWorldSubsystemData(AUTHORED, ["/A/b.b_C", "/A/c/d.d_C"], dest);
    expect(listOf(dest)).toEqual(["/A/b.b_C", "/A/c/d.d_C"]);
  });
});

describe("writeModWorldSubsystemData", () => {
  it("finds blueprints whose parent is ModWorldSubsystem", () => {
    const [raw] = modDirs({ "announce_mod_is_active.uasset": BLUEPRINT, "Other.uasset": AUTHORED });
    expect(findWorldSubsystemClasses(raw, "HeadlessArmors")).toEqual([CLASS]);
  });

  it("leaves an up-to-date editor asset untouched", () => {
    const name = "Autogenerated_1791837141_WorldSubsystemData.uasset";
    const dirs = modDirs({ "announce_mod_is_active.uasset": BLUEPRINT, [name]: AUTHORED });
    writeModWorldSubsystemData(...dirs, "HeadlessArmors");
    for (const dir of dirs) expect(readFileSync(path.join(dir, name)).equals(readFileSync(AUTHORED))).toBe(true);
  });

  it("generates the list for a mod that never had one, in raw/ and the SDK", () => {
    const dirs = modDirs({ "announce_mod_is_active.uasset": BLUEPRINT });
    writeModWorldSubsystemData(...dirs, "HeadlessArmors");
    for (const dir of dirs) {
      const [asset] = readdirSync(dir).filter((f) => f.endsWith("_WorldSubsystemData.uasset"));
      expect(parseUasset(path.join(dir, asset)).summary.packageName).toBe(
        `/HeadlessArmors/${path.basename(asset, ".uasset")}`,
      );
      expect(listOf(path.join(dir, asset))).toEqual([CLASS]);
    }
  });

  it("removes the list once the mod has no subsystem blueprints", () => {
    const name = "Autogenerated_1791837141_WorldSubsystemData.uasset";
    const dirs = modDirs({ [name]: AUTHORED });
    writeModWorldSubsystemData(...dirs, "HeadlessArmors");
    for (const dir of dirs) expect(existsSync(path.join(dir, name))).toBe(false);
  });
});
