; Proxy DLL forwarders for dwmapi.
;
; MSVC .def forwarders only accept `module.exportname` where `module` is a
; bare DLL basename — absolute paths don't work (linker treats them as
; unresolved local exports). So we forward to a neighbour DLL named
; `dwmapi_orig.dll` and have DllMain copy the real %SystemRoot%\System32
; copy into the game folder under that name on first load. See dllmain.cpp.
;
; The game's Binaries\Win64 is ahead of System32 in the DLL search order, so
; dwmapi_orig is resolved locally and the real DwmFlush (etc.) runs as if
; we weren't in the middle.

LIBRARY dwmapi

EXPORTS
    DwmAttachMilContent                 = dwmapi_orig.DwmAttachMilContent
    DwmDefWindowProc                    = dwmapi_orig.DwmDefWindowProc
    DwmDetachMilContent                 = dwmapi_orig.DwmDetachMilContent
    DwmEnableBlurBehindWindow           = dwmapi_orig.DwmEnableBlurBehindWindow
    DwmEnableComposition                = dwmapi_orig.DwmEnableComposition
    DwmEnableMMCSS                      = dwmapi_orig.DwmEnableMMCSS
    DwmExtendFrameIntoClientArea        = dwmapi_orig.DwmExtendFrameIntoClientArea
    DwmFlush                            = dwmapi_orig.DwmFlush
    DwmGetColorizationColor             = dwmapi_orig.DwmGetColorizationColor
    DwmGetCompositionTimingInfo         = dwmapi_orig.DwmGetCompositionTimingInfo
    DwmGetGraphicsStreamClient          = dwmapi_orig.DwmGetGraphicsStreamClient
    DwmGetGraphicsStreamTransformHint   = dwmapi_orig.DwmGetGraphicsStreamTransformHint
    DwmGetTransportAttributes           = dwmapi_orig.DwmGetTransportAttributes
    DwmGetUnmetTabRequirements          = dwmapi_orig.DwmGetUnmetTabRequirements
    DwmGetWindowAttribute               = dwmapi_orig.DwmGetWindowAttribute
    DwmInvalidateIconicBitmaps          = dwmapi_orig.DwmInvalidateIconicBitmaps
    DwmIsCompositionEnabled             = dwmapi_orig.DwmIsCompositionEnabled
    DwmModifyPreviousDxFrameDuration    = dwmapi_orig.DwmModifyPreviousDxFrameDuration
    DwmQueryThumbnailSourceSize         = dwmapi_orig.DwmQueryThumbnailSourceSize
    DwmRegisterThumbnail                = dwmapi_orig.DwmRegisterThumbnail
    DwmRenderGesture                    = dwmapi_orig.DwmRenderGesture
    DwmSetDxFrameDuration               = dwmapi_orig.DwmSetDxFrameDuration
    DwmSetIconicLivePreviewBitmap       = dwmapi_orig.DwmSetIconicLivePreviewBitmap
    DwmSetIconicThumbnail               = dwmapi_orig.DwmSetIconicThumbnail
    DwmSetPresentParameters             = dwmapi_orig.DwmSetPresentParameters
    DwmSetWindowAttribute               = dwmapi_orig.DwmSetWindowAttribute
    DwmShowContact                      = dwmapi_orig.DwmShowContact
    DwmTetherContact                    = dwmapi_orig.DwmTetherContact
    DwmTransitionOwnedWindow            = dwmapi_orig.DwmTransitionOwnedWindow
    DwmUnregisterThumbnail              = dwmapi_orig.DwmUnregisterThumbnail
    DwmUpdateThumbnailProperties        = dwmapi_orig.DwmUpdateThumbnailProperties
