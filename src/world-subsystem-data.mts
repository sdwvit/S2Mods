/**
 * Generates a mod's `Autogenerated_<n>_WorldSubsystemData.uasset`: the `ModWorldSubsystemDataAsset`
 * that lists the mod's `ModWorldSubsystem` blueprints. The game only creates a mod world subsystem
 * listed there, and finds the list by the `_WorldSubsystemData` file-name suffix (see
 * DesignDocs/DetectInstalledModSpec.md).
 *
 * The Mod Editor writes this asset when it packages a mod, but the CLI cook never runs that step,
 * and the asset's only field has no `EditAnywhere`, so it cannot be filled in by hand either. This
 * does the editor's job: every blueprint in the mod whose parent is `ModWorldSubsystem` goes in the
 * list. Same approach as `writeModLocalizationDatabase` in `localization/text.mts`.
 */
import { copyFileSync, existsSync, mkdtempSync, readdirSync, readFileSync, rmSync, statSync } from "node:fs";
import { createHash } from "node:crypto";
import os from "node:os";
import path from "node:path";

import { logger } from "./logger.mts";
import { parseUasset, renameLocalizationPackage, writeWorldSubsystemData } from "./localization/uasset.mts";

/** An empty `ModWorldSubsystemDataAsset` package: HeadlessArmors' editor-generated one, emptied. */
const EMPTY_TEMPLATE = path.join(import.meta.dirname, "localization/fixtures/empty-world-subsystem-data.uasset");

const ASSET_PATTERN = /^Autogenerated_\d+_WorldSubsystemData\.uasset$/;

/** A blueprint pulls in its parent's class-default object, so this import marks a direct child. */
const PARENT_CDO = "Default__ModWorldSubsystem";

function walk(dir: string): string[] {
  if (!existsSync(dir)) return [];
  return readdirSync(dir).flatMap((entry) => {
    const full = path.join(dir, entry);
    return statSync(full).isDirectory() ? walk(full) : [full];
  });
}

/**
 * `/<sdkModName>/<path>.<Class>_C` for every `ModWorldSubsystem` blueprint under `contentDir`,
 * sorted so the generated bytes don't depend on directory order.
 */
export function findWorldSubsystemClasses(contentDir: string, sdkModName: string): string[] {
  const needle = Buffer.from(PARENT_CDO, "latin1");
  return walk(contentDir)
    .filter((f) => f.endsWith(".uasset") && !ASSET_PATTERN.test(path.basename(f)))
    .filter((f) => readFileSync(f).includes(needle))
    .flatMap((f) => {
      const { imports, exports } = parseUasset(f);
      if (!imports.some((i) => i.objectName === PARENT_CDO)) return [];
      const generated = exports.find((e) => e.className === "BlueprintGeneratedClass");
      if (!generated) return [];
      const tail = path.relative(contentDir, f).replaceAll(path.sep, "/").replace(/\.uasset$/, "");
      return [`/${sdkModName}/${tail}.${generated.objectName}`];
    })
    .sort();
}

const assetIn = (dir: string) => (existsSync(dir) ? readdirSync(dir).find((f) => ASSET_PATTERN.test(f)) : undefined);

/**
 * Bring the mod's world-subsystem list in `contentDir` (raw/) and `sdkContentDir` in line with the
 * blueprints the mod holds. Files are only rewritten when their bytes change, so an unchanged mod
 * keeps its cook fingerprint.
 */
export function writeModWorldSubsystemData(contentDir: string, sdkContentDir: string, sdkModName: string) {
  const classPaths = findWorldSubsystemClasses(contentDir, sdkModName);
  const dirs = [contentDir, sdkContentDir].filter(existsSync);

  // Lists this can't read (older engine versions: the ShaysDistantHorizons repacks ship two from
  // UE5 file version 1008) are left exactly as they are; rewriting them is not safe.
  for (const dir of dirs) {
    for (const file of readdirSync(dir).filter((f) => ASSET_PATTERN.test(f))) {
      const list = parseUasset(path.join(dir, file)).exports.find(
        (e) => e.className === "ModWorldSubsystemDataAsset",
      )?.properties?.ModWorldSubsystems;
      if (!Array.isArray(list)) {
        logger.warn(`${sdkModName}: can't read ${file}, leaving the mod's world subsystem lists alone`);
        return classPaths;
      }
    }
  }

  // The editor names this after the moment it saved it, so keep whatever name is already in play
  // (the SDK's first: a Mod Editor package mints one there) and derive a stable one otherwise.
  const assetName =
    assetIn(sdkContentDir) ??
    assetIn(contentDir) ??
    `Autogenerated_${createHash("md5").update(sdkModName).digest().readUInt32BE(0)}_WorldSubsystemData.uasset`;

  // A second list under another name would register the same classes twice; none at all is right
  // for a mod whose last subsystem blueprint was removed.
  for (const dir of dirs) {
    for (const file of readdirSync(dir)) {
      if (!ASSET_PATTERN.test(file) || (file === assetName && classPaths.length)) continue;
      logger.info(`${sdkModName}: removing ${file} from ${path.basename(path.dirname(dir))}/${path.basename(dir)}`);
      rmSync(path.join(dir, file));
    }
  }
  if (!classPaths.length) return classPaths;

  const tmp = mkdtempSync(path.join(os.tmpdir(), "world-subsystem-data-"));
  try {
    const built = path.join(tmp, assetName);
    const packageName = `/${sdkModName}/${path.basename(assetName, ".uasset")}`;
    const template = [path.join(contentDir, assetName), path.join(sdkContentDir, assetName)].find(existsSync);
    if (template && parseUasset(template).summary.packageName === packageName) {
      writeWorldSubsystemData(template, classPaths, built);
    } else {
      renameLocalizationPackage(EMPTY_TEMPLATE, packageName, built);
      writeWorldSubsystemData(built, classPaths, built);
    }
    const bytes = readFileSync(built);
    for (const dir of dirs) {
      const dest = path.join(dir, assetName);
      if (existsSync(dest) && readFileSync(dest).equals(bytes)) continue;
      copyFileSync(built, dest);
      logger.info(`${sdkModName}: wrote ${assetName} to ${path.basename(path.dirname(dir))}/${path.basename(dir)}: ${classPaths.join(", ")}`);
    }
  } finally {
    rmSync(tmp, { recursive: true, force: true });
  }
  return classPaths;
}
